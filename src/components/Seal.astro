---
import type { Contributor } from '../data/contributors';
const { c, cls = '' } = Astro.props as { c: Contributor; cls?: string };
---
<svg class={cls} width="60" height="60" viewBox="0 0 64 64" role="img" aria-label={`${c.name}'s seal · AstrologyLib`}>
  <rect x="4" y="4" width="56" height="56" rx="3" fill="#950007"/>
  <rect x="4" y="4" width="56" height="56" rx="3" fill="none" stroke="#6E0406" stroke-width="1"/>
  <text x="32" y="13" text-anchor="middle" fill="#E8C766" font-size="8.5" font-family="sans-serif" font-weight="700" letter-spacing="2.5">CAL</text>
  <text x="32" y="30" text-anchor="middle" fill="#FFFFFF" font-size="19" font-family="serif" font-weight="700">{c.sealChar}</text>
  <text x="32" y="50" text-anchor="middle" fill="#FFFFFF" font-size="19" font-family="serif" font-weight="700">印</text>
</svg>

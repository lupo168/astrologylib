      { href: '/zhouyi/', label: 'The Zhou Yi (I Ching) · 周易經傳 (386 爻)' },
    ],
  },
  {
    href: '/tools/bazi-chart/', label: 'Tools', key: 'tools',
    children: [
      { href: '/tools/bazi-chart/', label: 'BaZi Chart · 真太陽時排盤' },
      { href: '/tools/ziwei/', label: 'Zi Wei Chart · 紫微斗數排盤' },
      { href: '/tools/hexagram/', label: 'Hexagram Cast · 周易起卦' },
    ],
  },
  {
    href: '/community/', label: 'Community', key: 'community',
    children: [
      { href: '/community/', label: 'Forum Index · 研討廣場' },
      { href: '/community/?cat=classics', label: 'Classics & Errata · 典籍校勘' },
      { href: '/community/?cat=bazi', label: 'BaZi & Destiny · 命理實證' },
      { href: '/community/?cat=dao', label: 'Daoist Canon · 道藏研讀' },
    ],
  },
  {
    href: '/contribute/', label: 'Contribute', key: 'contribute',
    children: [
      { href: '/contribute/', label: 'Volunteer · 參與' },
      { href: '/contributors/', label: 'Contributors · 名牆' },
      { href: '/contributor-agreement/', label: 'Contributor Agreement · 貢獻者協議' },
    ],
  },
  {
    href: '/about/', label: 'About', key: 'about',
    children: [
      { href: '/about/', label: 'About · 關於' },
      { href: '/license/', label: 'License · 許可' },
      { href: '/copyright/', label: 'Copyright · 版權' },
      { href: '/privacy/', label: 'Privacy · 隱私' },
    ],
  },
];

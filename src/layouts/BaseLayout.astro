---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'library' | 'learn' | 'reference' | 'tools' | 'contribute' | 'about' | 'community';
  ogType?: 'website' | 'article' | 'book';
  ogImage?: string;
  canonicalUrl?: string;
  schemaJson?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "AstrologyLib is an open-access classical Chinese astrology and cosmological digital library featuring 2,064 public-domain texts from the Yi Canon and Daoist Canon.",
  active = 'home',
  ogType = 'website',
  ogImage = 'https://astrologylib.org/logo.png',
  canonicalUrl,
  schemaJson
} = Astro.props;

const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site || 'https://astrologylib.org').href;

// Standard Schema.org Graph
const baseGraph: any[] = [
  {
    "@type": "Library",
    "@id": "https://astrologylib.org/#organization",
    "name": "AstrologyLib",
    "alternateName": [
      "AstrologyLib.org",
      "萬卷東方典藏庫",
      "中華術數古籍圖書館",
      "Chinese Astrology Library"
    ],
    "url": "https://astrologylib.org/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://astrologylib.org/logo.png",
      "width": 512,
      "height": 512
    },
    "description": "An open-access scholarly digital library dedicated to classical Chinese astrology, I Ching, BaZi, and ancient cosmological texts from the Yi and Daoist Canons.",
    "sameAs": [
      "https://github.com/lupo168/astrologylib"
    ],
    "email": "contact@astrologylib.org",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "contact@astrologylib.org",
      "contactType": "academic support"
    }
  },
  {
    "@type": "WebSite",
    "@id": "https://astrologylib.org/#website",
    "url": "https://astrologylib.org/",
    "name": "AstrologyLib",
    "publisher": {
      "@id": "https://astrologylib.org/#organization"
    },
    "inLanguage": ["en", "zh-Hant", "zh-Hans"]
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": title,
    "description": description,
    "isPartOf": {
      "@id": "https://astrologylib.org/#website"
    },
    "inLanguage": "en"
  }
];

if (schemaJson) {
  if (Array.isArray(schemaJson)) {
    baseGraph.push(...schemaJson);
  } else {
    baseGraph.push(schemaJson);
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": baseGraph
};

const DISCLAIMER = "For guidance and self-awareness purposes only. Not a substitute for medical, legal, financial, or psychological advice.";

interface NavItem {
  href: string;
  label: string;
  key: string;
  children?: { href: string; label: string }[];
}

const NAV: NavItem[] = [
  { href: '/', label: 'Home', key: 'home' },
  {
    href: '/learn/', label: 'Learn', key: 'learn',
    children: [
      { href: '/learn/', label: 'Beginner Primer · 零基礎導讀' },
      { href: '/learn/yin-yang/', label: 'Yin & Yang · 陰陽之道' },
      { href: '/learn/five-elements/', label: 'Five Elements · 五行生剋' },
      { href: '/learn/zodiac/', label: 'Chinese Zodiac · 十二生肖' },
      { href: '/learn/bazi/', label: 'BaZi Framework · 八字大綱' },
    ],
  },
  {
    href: '/traditions/', label: 'Traditions', key: 'traditions',
    children: [
      { href: '/traditions/', label: 'Traditions Overview · 大宗流派全景' },
      { href: '/learn/bazi/', label: 'BaZi · 四柱八字命理' },
      { href: '/traditions/ziwei/', label: 'Zi Wei Dou Shu · 紫微斗數' },
      { href: '/traditions/liuyao/', label: 'Liu Yao Divination · 六爻神卦' },
      { href: '/zhouyi/', label: 'The Zhou Yi (I Ching) · 周易象數 (386 爻)' },
    ],
  },
  {
    href: '/glossary/', label: 'Glossary', key: 'reference',
    children: [
      { href: '/glossary/', label: 'Core Essentials · 核心基石必讀' },
      { href: '/reference/quick-reference/', label: 'Quick Reference · 體系速查表' },
      { href: '/glossary/?view=all', label: 'Canonical Lexicon · 標準全庫檢索' },
    ],
  },
  {
    href: '/library/', label: 'Library', key: 'library',
    children: [
      { href: '/library/classics/', label: 'Grand Corpus · 萬卷典藏總庫 (2,064 卷)' },
      { href: '/reference/timeline/', label: 'Historical Lineage & Timeline · 典籍歷史源流線' },

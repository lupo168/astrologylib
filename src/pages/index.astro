---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "AstrologyLib - The Public-Domain Source for Chinese Metaphysics";
const description = "From 0-to-1 beginner primer to the 2,064-volume Grand Classical Corpus: verified translations, standardized canonical glossary, and public-domain Chinese metaphysics. Sources you can check, guidance without promises.";
---

<BaseLayout title={title} description={description} active="home">
  <!-- Hero Section -->
  <section class="hero" style="padding-bottom:32px">
    <div class="hero-inner">
      <div class="kicker">The Public-Domain Source Library</div>
      <h1><span class="en">Chinese Astrology Library</span>溯源 · 入門 · 可驗證<br />From Zero to Classical Canon, in Clear English</h1>
      <span hidden data-deploy-test="20260910-cal-ladder">auto</span>
      <p class="lede">
        We bridge 3,000 years of Eastern cosmology through a rigorous <strong>four-pillar cognitive pathway</strong>: 
        <strong>0-to-1 beginner onboarding</strong>, <strong>major applied traditions</strong>, a <strong>standardized canonical glossary</strong>, and our <strong>2,064-volume Grand Classical Corpus</strong>. 
        No mystification. No empty promises. Sources you can verify.
      </p>
      <div class="cta-row" style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="/learn/" style="padding:12px 20px">
          1. Start from Zero · 零基礎入門 →
        </a>
        <a class="btn btn-secondary" href="/traditions/" style="padding:12px 18px">
          2. Traditions · 大宗流派 🧭
        </a>
        <a class="btn btn-secondary" href="/glossary/" style="padding:12px 18px">
          3. Standard Glossary · 查閱術語庫 📖
        </a>
        <a class="btn btn-secondary" href="/library/" style="padding:12px 18px">
          4. Grand Corpus · 萬卷典籍 📜
        </a>
      </div>
    </div>
    <figure class="hero-meta">
      <div class="seal-logo" role="img" aria-label="易 · The Book of Changes">

  <!-- 四合一認知階梯核心架構展台 (The Four-Pillar Cognitive Pathway) -->
  <section class="ladder-section" style="max-width:var(--content-max);margin:0 auto 40px;padding:0 24px">
    <div style="text-align:center;max-width:760px;margin:0 auto 28px">
      <div style="font-size:12px;font-weight:700;color:var(--red);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:6px">THE FOUR-PILLAR COGNITIVE PATHWAY · 四階研學體系</div>
      <h2 style="font-family:var(--font-heading);font-size:28px;margin:0 0 10px;color:var(--ink)">
        從入門、流派、查詞到原典的四階認知體系
      </h2>
      <p style="font-size:15px;color:var(--ink-700);line-height:1.7;margin:0">
        Don't get overwhelmed by archaic texts. Follow our verified 4-step pathway from universal cosmological building blocks to primary classical editions.
      </p>
    </div>

    <div class="ladder-grid" style="display:grid;grid-template-columns:repeat(4, 1fr);gap:20px">
      
      <!-- 阶梯 1：零基础入门 -->
      <div class="ladder-card" style="background:var(--paper);border:1px solid var(--ink-300);border-top:4px solid var(--gold);border-radius:var(--radius-card);padding:22px 18px;display:flex;flex-direction:column;box-shadow:0 3px 12px rgba(0,0,0,0.02)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <span style="font-size:11px;font-weight:800;color:var(--gold);background:rgba(212,175,55,0.12);padding:2px 8px;border-radius:4px">STEP 1 · 入門</span>
          <span style="font-size:11px;color:var(--ink-500)">0-to-1 Primer</span>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:18px;margin:0 0 8px;color:var(--ink)">
          Beginner Primer · 零基礎
        </h3>
        <p style="font-size:13px;color:var(--ink-700);line-height:1.6;margin-bottom:14px;flex:1">
          Demystifying cosmology into natural philosophy. Plain-English first steps explaining Yin-Yang, the Five Phases, Chinese Zodiac archetypes, and natal BaZi logic.
        </p>
        <ul style="list-style:none;padding:0;margin:0 0 14px;font-size:12px;line-height:1.75">
          <li><a href="/learn/yin-yang/" style="color:var(--ink);text-decoration:none">☯️ <strong>Yin &amp; Yang</strong> — Natural rhythm →</a></li>
          <li><a href="/learn/five-elements/" style="color:var(--ink);text-decoration:none">🌱 <strong>Five Elements</strong> — Seasonal phases →</a></li>
          <li><a href="/learn/zodiac/" style="color:var(--ink);text-decoration:none">🐎 <strong>Chinese Zodiac</strong> — 12 animals →</a></li>
          <li><a href="/learn/bazi/" style="color:var(--ink);text-decoration:none">📜 <strong>BaZi Framework</strong> — Four pillars →</a></li>
        </ul>
        <a class="btn btn-secondary" href="/learn/" style="text-align:center;font-size:12px;padding:8px">
          Start the Primer →
        </a>
      </div>

      <!-- 阶梯 2：大宗流派 -->
      <div class="ladder-card" style="background:var(--paper);border:1px solid var(--ink-300);border-top:4px solid var(--gold);border-radius:var(--radius-card);padding:22px 18px;display:flex;flex-direction:column;box-shadow:0 3px 12px rgba(0,0,0,0.02)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <span style="font-size:11px;font-weight:800;color:var(--gold);background:rgba(212,175,55,0.12);padding:2px 8px;border-radius:4px">STEP 2 · 流派</span>
          <span style="font-size:11px;color:var(--ink-500)">Major Traditions</span>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:18px;margin:0 0 8px;color:var(--ink)">
          Traditions · 大宗流派
        </h3>
        <p style="font-size:13px;color:var(--ink-700);line-height:1.6;margin-bottom:14px;flex:1">
          Deep-dive into the four classical calculation systems: Four Pillars BaZi, Purple Star Zi Wei, Six Lines Liu Yao, and the Book of Changes (Zhou Yi).
        </p>
        <ul style="list-style:none;padding:0;margin:0 0 14px;font-size:12px;line-height:1.75">
          <li><a href="/learn/bazi/" style="color:var(--ink);text-decoration:none">📜 <strong>BaZi</strong> — Solar stems &amp; branches →</a></li>
          <li><a href="/traditions/ziwei/" style="color:var(--ink);text-decoration:none">✨ <strong>Zi Wei Dou Shu</strong> — 12 Palaces →</a></li>
          <li><a href="/traditions/liuyao/" style="color:var(--ink);text-decoration:none">🪙 <strong>Liu Yao</strong> — Six Lines Divination →</a></li>
          <li><a href="/zhouyi/" style="color:var(--ink);text-decoration:none">📖 <strong>The Zhou Yi</strong> — 386 Lines Canon →</a></li>
        </ul>
        <a class="btn btn-secondary" href="/traditions/" style="text-align:center;font-size:12px;padding:8px">
          Explore Traditions →
        </a>
      </div>

      <!-- 阶梯 3：标准术语库 -->
      <div class="ladder-card" style="background:var(--paper);border:1px solid var(--ink-300);border-top:4px solid var(--red);border-radius:var(--radius-card);padding:22px 18px;display:flex;flex-direction:column;box-shadow:0 3px 12px rgba(0,0,0,0.02)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <span style="font-size:11px;font-weight:800;color:var(--red);background:rgba(149,0,7,0.08);padding:2px 8px;border-radius:4px">STEP 3 · 查詞</span>
          <span style="font-size:11px;color:var(--red);font-weight:700">Canonical Lexicon</span>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:18px;margin:0 0 8px;color:var(--ink)">
          Glossary · 標準術語庫
        </h3>
        <p style="font-size:13px;color:var(--ink-700);line-height:1.6;margin-bottom:14px;flex:1">
          The official bilingual standard dictionary. 24 Core Essentials for beginners and 200+ reference terms with Pinyin, definitions, and classical source citations.
        </p>
        <div style="background:var(--paper-warm);border:1px solid var(--ink-200);border-radius:6px;padding:8px 10px;margin-bottom:14px;font-size:11px;color:var(--ink-700)">
          <div style="font-weight:700;color:var(--ink);margin-bottom:4px">Standard Lookups:</div>
          <div style="display:flex;gap:4px;flex-wrap:wrap">
            <span style="background:#fff;border:1px solid var(--ink-300);padding:1px 5px;border-radius:3px">日主 (Day Master)</span>
            <span style="background:#fff;border:1px solid var(--ink-300);padding:1px 5px;border-radius:3px">紫微星 (Zi Wei)</span>
            <span style="background:#fff;border:1px solid var(--ink-300);padding:1px 5px;border-radius:3px">世應 (Shi &amp; Ying)</span>
            <span style="background:#fff;border:1px solid var(--ink-300);padding:1px 5px;border-radius:3px">六親 (Six Kinships)</span>
          </div>
        </div>
        <a class="btn btn-primary" href="/glossary/" style="text-align:center;font-size:12px;padding:8px">
          Search Lexicon 🔍
        </a>
      </div>

      <!-- 阶梯 4：典籍总库 -->
      <div class="ladder-card" style="background:var(--paper);border:1px solid var(--ink-300);border-top:4px solid var(--ink);border-radius:var(--radius-card);padding:22px 18px;display:flex;flex-direction:column;box-shadow:0 3px 12px rgba(0,0,0,0.02)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <span style="font-size:11px;font-weight:800;color:var(--ink);background:var(--ink-200);padding:2px 8px;border-radius:4px">STEP 4 · 原典</span>
          <span style="font-size:11px;color:var(--ink-500)">2,064 Canons</span>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:18px;margin:0 0 8px;color:var(--ink)">
          Library · 萬卷典藏總庫
        </h3>
        <p style="font-size:13px;color:var(--ink-700);line-height:1.6;margin-bottom:14px;flex:1">
          The ultimate primary text bedrock. 2,064 public-domain volumes in one unified, searchable collection, mapped directly to historical dynasties and citations.
        </p>
        <ul style="list-style:none;padding:0;margin:0 0 14px;font-size:12px;line-height:1.75">
          <li><a href="/library/classics/" style="color:var(--ink);text-decoration:none">🏛️ <strong>Grand Corpus</strong> — 2,064 volumes →</a></li>
          <li><a href="/reference/timeline/" style="color:var(--ink);text-decoration:none">🕰️ <strong>Historical Lineage</strong> — 3,000-year map →</a></li>
          <li><a href="/zhouyi/" style="color:var(--ink);text-decoration:none">📖 <strong>The Zhou Yi</strong> — 386 lines bilingual →</a></li>
          <li><a href="/library/read/?type=daozang&id=DAO-1496" style="color:var(--ink);text-decoration:none">✨ <strong>Zi Wei Daozang</strong> — DAO-1496 edition →</a></li>
        </ul>
        <a class="btn btn-secondary" href="/library/" style="text-align:center;font-size:12px;padding:8px">
          Enter Grand Corpus →
        </a>
      </div>

    </div>
  </section>

  <!-- 萬卷典藏 2,064 卷大库重磅展台 -->
  <section class="grand-corpus-banner" style="max-width:var(--content-max);margin:0 auto 36px;padding:0 24px">
    <div style="background:linear-gradient(135deg, rgba(149,0,7,0.05), rgba(212,175,55,0.12));border:1px solid var(--gold);border-left:4px solid var(--red);border-radius:var(--radius-card);padding:28px 32px;box-shadow:0 4px 18px rgba(0,0,0,0.03)">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:20px;margin-bottom:20px">
        <div style="max-width:760px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
            <span style="background:var(--red);color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase">Monumental Open Archive</span>
            <span style="font-size:13px;color:var(--ink-700);font-weight:600">2,064 Volumes · 100% Public Domain</span>
          </div>
          <h2 style="font-family:var(--font-heading);font-size:26px;font-weight:900;color:var(--ink);margin:0 0 8px">
            萬卷典藏 · 中華古典古籍庫 <span style="font-size:18px;font-weight:400;color:var(--ink-700)">Grand Classical Corpus</span>
          </h2>
          <p style="font-size:15px;color:var(--ink-700);line-height:1.7;margin:0">
            Preserving 3,000 years of Eastern cosmology, divination, internal alchemy, and metaphysics. Complete with dynastic dating, authorial attribution, and an ink-wash reader with scholarly citations.
          </p>
        </div>
        <a class="btn btn-primary" href="/library/classics/" style="white-space:nowrap;padding:12px 24px;font-size:15px">
          Explore Grand Corpus (2,064) →
        </a>
      </div>

      <!-- 核心指标与朝代直通 -->

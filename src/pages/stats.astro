    font-weight: 600;
    background: var(--ink-100);
    color: var(--ink-700);
    padding: 2px 8px;
    border-radius: var(--radius-btn);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .data-table th {
    background: #fdfcfb;
    padding: 10px 20px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-500);
    border-bottom: 1px solid var(--ink-100);
  }

  .data-table td {
    padding: 12px 20px;
    border-bottom: 1px solid #f2ede4;
    color: var(--ink);
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* Web Vitals */
  .vitals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    padding: 20px;
  }

  .vital-box {
    background: #fcfbf9;
    border: 1px solid var(--ink-100);
    border-radius: var(--radius-card);
    padding: 16px;
  }

  .v-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-500);
    text-transform: uppercase;
  }

  .v-val {

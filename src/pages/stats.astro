    font-size: 20px;
    font-weight: 900;
    margin: 6px 0;
  }

  .v-desc {
    font-size: 12px;
    color: var(--ink-500);
    line-height: 1.45;
  }

  /* 操作按钮 */
  .stats-footer-nav {
    margin-top: 36px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--radius-btn);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--red);
    color: #fff;
  }

  .btn-primary:hover {
    background: #7a0006;
    color: #fff;
  }

  .btn-secondary {
    background: #fff;
    border: 1px solid var(--ink-300);
    color: var(--ink);
  }

  .btn-secondary:hover {
    border-color: var(--red);
    color: var(--red);
  }

  @media (max-width: 768px) {
    .stats-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>

  .wing-head { display:flex; align-items:baseline; gap:12px; margin-bottom:4px; }
  .wing-zh { font-family:var(--font-heading); font-weight:900; font-size:18px; color:var(--ink); }
  .wing-en { font-size:15px; color:var(--red); font-weight:600; }
  .wing-desc { font-size:14px; color:var(--ink-700); line-height:1.7; margin:0; }
  .xici-ch { margin-bottom:28px; }
  .xici-ch h3 { display:flex; align-items:baseline; gap:10px; font-family:var(--font-heading); font-size:20px; }
  .ch-num { font-size:13px; color:var(--red); font-weight:700; }
  .ch-zh { font-size:16px; color:var(--ink-500); font-weight:500; }
  .ch-zh-text { font-size:15px; color:var(--ink); line-height:1.8; margin:10px 0; }
  .ch-en-text { font-size:15px; color:var(--ink-700); line-height:1.75; }
</style>
